layout(set = 0, binding = 0, std430) buffer Charge { float charge[]; };
layout(set = 0, binding = 1, std430) buffer ChargeSquare { float charge_square[]; };
layout(push_constant) uniform Params { int element_number; } pc;
void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(pc.element_number)) return;
    float q = charge[i];
    charge_square[i] = q * q;
}
