layout(set = 0, binding = 0, std430) buffer MassInv { float mass_inverse[]; };
layout(set = 0, binding = 1, std430) buffer Frc { Vec3 frc[]; };
layout(set = 0, binding = 2, std430) buffer Vel { Vec3 vel[]; };
layout(set = 0, binding = 3, std430) buffer Acc { Vec3 acc[]; };
layout(push_constant) uniform Params
{
    int atom_numbers;
    float beta1;
    float beta2;
    float epsilon;
    float first_bias;
    float second_bias_sqrt;
}
pc;
float adam_step(float f, inout float moment, inout float root)
{
    f = clamp(f, -1e10, 1e10);
    float m = pc.beta1 * moment + (1.0 - pc.beta1) * f;
    float s = max(abs(root), abs(f));
    float r = s > 0.0 ? s * sqrt(pc.beta2 * (root / s) * (root / s) +
                                 (1.0 - pc.beta2) * (f / s) * (f / s))
                      : 0.0;
    moment = m;
    root = r;
    return (m / pc.first_bias) / (r / pc.second_bias_sqrt + pc.epsilon);
}
void main()
{
    int i = int(gl_GlobalInvocationID.x);
    if (i >= pc.atom_numbers) return;
    if (mass_inverse[i] == 0.0)
    {
        frc[i] = Vec3(0.0, 0.0, 0.0);
        return;
    }
    Vec3 f = frc[i];
    Vec3 moment = vel[i];
    Vec3 root = acc[i];
    frc[i] = Vec3(adam_step(f.x, moment.x, root.x),
                  adam_step(f.y, moment.y, root.y),
                  adam_step(f.z, moment.z, root.z));
    vel[i] = moment;
    acc[i] = root;
}
