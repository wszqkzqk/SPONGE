layout(set = 0, binding = 0, std430) buffer AtomLocal { int atom_local[]; };
layout(set = 0, binding = 1, std430) buffer GlobalTypes
{
    int global_pairwise_types[];
};
layout(set = 0, binding = 2, std430) buffer LocalTypes
{
    int local_pairwise_types[];
};
layout(push_constant) uniform Params { int total_numbers; } pc;
void main()
{
    int i = int(gl_GlobalInvocationID.x);
    if (i >= pc.total_numbers) return;
    local_pairwise_types[i] = global_pairwise_types[atom_local[i]];
}
