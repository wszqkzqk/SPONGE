layout(set = 0, binding = 0, std430) buffer ExcludedNumbers
{
    int d_excluded_numbers[];
};
layout(set = 0, binding = 1, std430) buffer ExcludedListStart
{
    int d_excluded_list_start[];
};
layout(set = 0, binding = 2, std430) buffer ExcludedList
{
    int d_excluded_list[];
};
layout(set = 0, binding = 3, std430) buffer AtomLocal { int atom_local[]; };
layout(set = 0, binding = 4, std430) buffer LocalId { int atom_local_id[]; };
layout(set = 0, binding = 5, std430) buffer MdExcludedNumbers
{
    int md_excluded_numbers[];
};
layout(set = 0, binding = 6, std430) buffer MdExcludedListStart
{
    int md_excluded_list_start[];
};
layout(set = 0, binding = 7, std430) buffer MdExcludedList
{
    int md_excluded_list[];
};
layout(push_constant) uniform Params { int atom_numbers; } pc;
void main()
{
    if (gl_GlobalInvocationID.x != 0u) return;
    int count = 0;
    for (int i = 0; i < pc.atom_numbers; ++i)
    {
        int atom_i = atom_local[i];
        d_excluded_numbers[i] = md_excluded_numbers[atom_i];
        d_excluded_list_start[i] = count;
        if (d_excluded_numbers[i] > 0)
        {
            int start_global = md_excluded_list_start[atom_i];
            int end_global = start_global + md_excluded_numbers[atom_i];
            for (int j = start_global; j < end_global; ++j)
            {
                int atom_j = md_excluded_list[j];
                d_excluded_list[count] = atom_local_id[atom_j];
                count++;
            }
        }
    }
}
