layout(set = 0, binding = 0, std430) buffer Crd { Vec3 crd[]; };
layout(set = 0, binding = 1, std430) buffer AtomTypes { int atom_types[]; };
layout(set = 0, binding = 2, std430) buffer Shield { float shield[]; };
layout(set = 0, binding = 3, std430) buffer NL { uvec4 nl_raw[]; };
layout(set = 0, binding = 4, std430) buffer NLSerial { int nl_serial[]; };
layout(set = 0, binding = 5, std430) buffer NumNbrs { int numnbrs[]; };
layout(push_constant) uniform Params
{
    int atom_numbers;
    Boundary boundary;
    float cutoff;
    int atom_type_numbers;
    int max_neighbor_numbers;
}
pc;
void main()
{
    int i = int(gl_GlobalInvocationID.x);
    if (i >= pc.atom_numbers) return;
    int count = 0;
    Vec3 ri = crd[i];
    int type_i = atom_types[i];
    int nl_count = int(nl_raw[i].x);
    int base = i * pc.max_neighbor_numbers;
    for (int j_idx = 0; j_idx < nl_count; j_idx++)
    {
        int atom_j = nl_serial[base + j_idx];
        int type_j = atom_types[atom_j];
        Vec3 rj = crd[atom_j];
        Vec3 drij = get_displacement_periodic(ri, rj, pc.boundary);
        float r2 = v3_dot(drij, drij);
        float r = sqrt(r2);
        if (r < pc.cutoff)
        {
            float shield_ij = shield[type_i * pc.atom_type_numbers + type_j];
            if (shield_ij >= 0.0) count++;
        }
    }
    numnbrs[i] = count;
}
