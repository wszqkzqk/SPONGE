layout(set = 0, binding = 0, std430) buffer MassInv { float mass_inverse[]; };
layout(set = 0, binding = 1, std430) buffer Frc { Vec3 frc[]; };
layout(set = 0, binding = 2, std430) buffer Vel { Vec3 vel[]; };
layout(set = 0, binding = 3, std430) buffer Acc { Vec3 acc[]; };
layout(push_constant) uniform Params
{
    int atom_numbers;
    float beta1;
    float beta2;
    float epsilon;
    float t;
}
pc;
void main()
{
    int i = int(gl_GlobalInvocationID.x);
    if (i >= pc.atom_numbers) return;
    Vec3 f = frc[i];
    Vec3 f2 = v3_mul(f, f);
    vel[i] = v3_add(v3_scale(vel[i], pc.beta1),
                    v3_scale(v3_scale(f, mass_inverse[i]), 1.0 - pc.beta1));
    acc[i] = v3_add(v3_scale(acc[i], pc.beta2), v3_scale(f2, 1.0 - pc.beta2));
    f = v3_scale(vel[i], 1.0 / (1.0 - pow(pc.beta1, pc.t + 1.0)));
    f2 = v3_scale(acc[i], 1.0 / (1.0 - pow(pc.beta2, pc.t + 1.0)));
    frc[i] = Vec3(f.x / (sqrt(f2.x) + pc.epsilon),
                  f.y / (sqrt(f2.y) + pc.epsilon),
                  f.z / (sqrt(f2.z) + pc.epsilon));
}
