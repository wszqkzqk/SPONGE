layout(set = 0, binding = 0, std430) buffer M_ { float m[]; };
layout(set = 0, binding = 1, std430) buffer R_ { float R[]; };

const float SVD_GAMMA = 5.828427124;
const float SVD_CSTAR = 0.923879532;
const float SVD_SSTAR = 0.3826834323;
const float SVD_EPSILON = 1e-6;

struct SvdMat3
{
    float m_00, m_01, m_02;
    float m_10, m_11, m_12;
    float m_20, m_21, m_22;
};

struct SvdSym3
{
    float m_00;
    float m_10, m_11;
    float m_20, m_21, m_22;
};

struct SvdGivens
{
    float ch, sh;
};

struct SvdQR
{
    SvdMat3 Q, R;
};

float svd_rsqrt(float x)
{
    float xhalf = -0.5 * x;
    int i = floatBitsToInt(x);
    i = 0x5f375a82 - (i >> 1);
    x = intBitsToFloat(i);
    for (int it = 0; it < 4; it++) x = x * fma(x * x, xhalf, 1.5);
    return x;
}

float svd_rsqrt1(float x)
{
    float xhalf = -0.5 * x;
    int i = floatBitsToInt(x);
    i = 0x5f37599e - (i >> 1);
    x = intBitsToFloat(i);
    for (int it = 0; it < 6; it++) x = x * fma(x * x, xhalf, 1.5);
    return x;
}

float svd_accurate_sqrt(float x) { return 1.0 / svd_rsqrt1(x); }

void svd_cond_swap(bool c, inout float X, inout float Y)
{
    float Z = X;
    X = c ? Y : X;
    Y = c ? Z : Y;
}

void svd_cond_neg_swap(bool c, inout float X, inout float Y)
{
    float Z = -X;
    X = c ? Y : X;
    Y = c ? Z : Y;
}

SvdMat3 svd_mat3_transpose(SvdMat3 a)
{
    return SvdMat3(a.m_00, a.m_10, a.m_20, a.m_01, a.m_11, a.m_21, a.m_02,
                   a.m_12, a.m_22);
}

SvdMat3 svd_mat3_mul(SvdMat3 a, SvdMat3 o)
{
    SvdMat3 r;
    r.m_00 = fma(a.m_00, o.m_00, fma(a.m_01, o.m_10, a.m_02 * o.m_20));
    r.m_01 = fma(a.m_00, o.m_01, fma(a.m_01, o.m_11, a.m_02 * o.m_21));
    r.m_02 = fma(a.m_00, o.m_02, fma(a.m_01, o.m_12, a.m_02 * o.m_22));
    r.m_10 = fma(a.m_10, o.m_00, fma(a.m_11, o.m_10, a.m_12 * o.m_20));
    r.m_11 = fma(a.m_10, o.m_01, fma(a.m_11, o.m_11, a.m_12 * o.m_21));
    r.m_12 = fma(a.m_10, o.m_02, fma(a.m_11, o.m_12, a.m_12 * o.m_22));
    r.m_20 = fma(a.m_20, o.m_00, fma(a.m_21, o.m_10, a.m_22 * o.m_20));
    r.m_21 = fma(a.m_20, o.m_01, fma(a.m_21, o.m_11, a.m_22 * o.m_21));
    r.m_22 = fma(a.m_20, o.m_02, fma(a.m_21, o.m_12, a.m_22 * o.m_22));
    return r;
}

float svd_mat3_det(SvdMat3 a)
{
    return fma(a.m_00, fma(a.m_11, a.m_22, -a.m_21 * a.m_12),
               fma(-a.m_01, fma(a.m_10, a.m_22, -a.m_20 * a.m_12),
                   a.m_02 * fma(a.m_10, a.m_21, -a.m_20 * a.m_11)));
}

SvdMat3 svd_mat3_from_quat(vec4 q)
{
    SvdMat3 r;
    r.m_00 = 1.0 - 2.0 * fma(q.y, q.y, q.z * q.z);
    r.m_01 = 2.0 * fma(q.x, q.y, -q.w * q.z);
    r.m_02 = 2.0 * fma(q.x, q.z, q.w * q.y);
    r.m_10 = 2.0 * fma(q.x, q.y, q.w * q.z);
    r.m_11 = 1.0 - 2.0 * fma(q.x, q.x, q.z * q.z);
    r.m_12 = 2.0 * fma(q.y, q.z, -q.w * q.x);
    r.m_20 = 2.0 * fma(q.x, q.z, -q.w * q.y);
    r.m_21 = 2.0 * fma(q.y, q.z, q.w * q.x);
    r.m_22 = 1.0 - 2.0 * fma(q.x, q.x, q.y * q.y);
    return r;
}

float svd_dist2(float x, float y, float z) { return fma(x, x, fma(y, y, z * z)); }

SvdGivens svd_approx_givens_quat(SvdSym3 A)
{
    float ch = 2.0 * (A.m_00 - A.m_11);
    float sh = A.m_10;
    bool b = SVD_GAMMA * sh * sh < ch * ch;
    float w = svd_rsqrt(fma(ch, ch, sh * sh));
    if (isnan(w)) b = false;
    return SvdGivens(b ? w * ch : SVD_CSTAR, b ? w * sh : SVD_SSTAR);
}

void svd_jacobi_conjugation(int x, int y, int z, inout SvdSym3 S, inout vec4 q)
{
    SvdGivens g = svd_approx_givens_quat(S);
    float scale = 1.0 / fma(g.ch, g.ch, g.sh * g.sh);
    float a = fma(g.ch, g.ch, -g.sh * g.sh) * scale;
    float b = 2.0 * g.sh * g.ch * scale;
    SvdSym3 _S = S;
    S.m_00 = fma(a, fma(a, _S.m_00, b * _S.m_10),
                 b * (fma(a, _S.m_10, b * _S.m_11)));
    S.m_10 = fma(a, fma(-b, _S.m_00, a * _S.m_10),
                 b * (fma(-b, _S.m_10, a * _S.m_11)));
    S.m_11 = fma(-b, fma(-b, _S.m_00, a * _S.m_10),
                 a * (fma(-b, _S.m_10, a * _S.m_11)));
    S.m_20 = fma(a, _S.m_20, b * _S.m_21);
    S.m_21 = fma(-b, _S.m_20, a * _S.m_21);
    S.m_22 = _S.m_22;
    float tmp[3];
    tmp[0] = q[0] * g.sh;
    tmp[1] = q[1] * g.sh;
    tmp[2] = q[2] * g.sh;
    g.sh *= q[3];
    q[z] = fma(q[z], g.ch, g.sh);
    q[3] = fma(q[3], g.ch, -tmp[z]);
    q[x] = fma(q[x], g.ch, tmp[y]);
    q[y] = fma(q[y], g.ch, -tmp[x]);
    _S.m_00 = S.m_11;
    _S.m_10 = S.m_21;
    _S.m_11 = S.m_22;
    _S.m_20 = S.m_10;
    _S.m_21 = S.m_20;
    _S.m_22 = S.m_00;
    S.m_00 = _S.m_00;
    S.m_10 = _S.m_10;
    S.m_11 = _S.m_11;
    S.m_20 = _S.m_20;
    S.m_21 = _S.m_21;
    S.m_22 = _S.m_22;
}

vec4 svd_jacobi_eigenanalysis(SvdSym3 S)
{
    vec4 q = vec4(0.0, 0.0, 0.0, 1.0);
    for (int i = 0; i < 12; i++)
    {
        svd_jacobi_conjugation(0, 1, 2, S, q);
        svd_jacobi_conjugation(1, 2, 0, S, q);
        svd_jacobi_conjugation(2, 0, 1, S, q);
    }
    return q;
}

void svd_sort_singular_values(inout SvdMat3 B, inout SvdMat3 V)
{
    float rho1 = svd_dist2(B.m_00, B.m_10, B.m_20);
    float rho2 = svd_dist2(B.m_01, B.m_11, B.m_21);
    float rho3 = svd_dist2(B.m_02, B.m_12, B.m_22);
    bool c;
    c = rho1 < rho2;
    svd_cond_neg_swap(c, B.m_00, B.m_01);
    svd_cond_neg_swap(c, V.m_00, V.m_01);
    svd_cond_neg_swap(c, B.m_10, B.m_11);
    svd_cond_neg_swap(c, V.m_10, V.m_11);
    svd_cond_neg_swap(c, B.m_20, B.m_21);
    svd_cond_neg_swap(c, V.m_20, V.m_21);
    svd_cond_swap(c, rho1, rho2);
    c = rho1 < rho3;
    svd_cond_neg_swap(c, B.m_00, B.m_02);
    svd_cond_neg_swap(c, V.m_00, V.m_02);
    svd_cond_neg_swap(c, B.m_10, B.m_12);
    svd_cond_neg_swap(c, V.m_10, V.m_12);
    svd_cond_neg_swap(c, B.m_20, B.m_22);
    svd_cond_neg_swap(c, V.m_20, V.m_22);
    svd_cond_swap(c, rho1, rho3);
    c = rho2 < rho3;
    svd_cond_neg_swap(c, B.m_01, B.m_02);
    svd_cond_neg_swap(c, V.m_01, V.m_02);
    svd_cond_neg_swap(c, B.m_11, B.m_12);
    svd_cond_neg_swap(c, V.m_11, V.m_12);
    svd_cond_neg_swap(c, B.m_21, B.m_22);
    svd_cond_neg_swap(c, V.m_21, V.m_22);
}

SvdGivens svd_qr_givens_quat(float a1, float a2)
{
    float rho = svd_accurate_sqrt(fma(a1, a1, a2 * a2));
    float ch = abs(a1) + max(rho, SVD_EPSILON);
    float sh = rho > SVD_EPSILON ? a2 : 0.0;
    bool b = a1 < 0.0;
    svd_cond_swap(b, sh, ch);
    float w = svd_rsqrt(fma(ch, ch, sh * sh));
    return SvdGivens(ch * w, sh * w);
}

SvdQR svd_qr_decomposition(SvdMat3 B)
{
    SvdMat3 Q, R;
    SvdGivens g1 = svd_qr_givens_quat(B.m_00, B.m_10);
    float a = fma(-2.0, g1.sh * g1.sh, 1.0);
    float b = 2.0 * g1.ch * g1.sh;
    R.m_00 = fma(a, B.m_00, b * B.m_10);
    R.m_01 = fma(a, B.m_01, b * B.m_11);
    R.m_02 = fma(a, B.m_02, b * B.m_12);
    R.m_10 = fma(-b, B.m_00, a * B.m_10);
    R.m_11 = fma(-b, B.m_01, a * B.m_11);
    R.m_12 = fma(-b, B.m_02, a * B.m_12);
    R.m_20 = B.m_20;
    R.m_21 = B.m_21;
    R.m_22 = B.m_22;
    SvdGivens g2 = svd_qr_givens_quat(R.m_00, R.m_20);
    a = fma(-2.0, g2.sh * g2.sh, 1.0);
    b = 2.0 * g2.ch * g2.sh;
    B.m_00 = fma(a, R.m_00, b * R.m_20);
    B.m_01 = fma(a, R.m_01, b * R.m_21);
    B.m_02 = fma(a, R.m_02, b * R.m_22);
    B.m_10 = R.m_10;
    B.m_11 = R.m_11;
    B.m_12 = R.m_12;
    B.m_20 = fma(-b, R.m_00, a * R.m_20);
    B.m_21 = fma(-b, R.m_01, a * R.m_21);
    B.m_22 = fma(-b, R.m_02, a * R.m_22);
    SvdGivens g3 = svd_qr_givens_quat(B.m_11, B.m_21);
    a = fma(-2.0, g3.sh * g3.sh, 1.0);
    b = 2.0 * g3.ch * g3.sh;
    R.m_00 = B.m_00;
    R.m_01 = B.m_01;
    R.m_02 = B.m_02;
    R.m_10 = fma(a, B.m_10, b * B.m_20);
    R.m_11 = fma(a, B.m_11, b * B.m_21);
    R.m_12 = fma(a, B.m_12, b * B.m_22);
    R.m_20 = fma(-b, B.m_10, a * B.m_20);
    R.m_21 = fma(-b, B.m_11, a * B.m_21);
    R.m_22 = fma(-b, B.m_12, a * B.m_22);
    float sh12 = 2.0 * fma(g1.sh, g1.sh, -0.5);
    float sh22 = 2.0 * fma(g2.sh, g2.sh, -0.5);
    float sh32 = 2.0 * fma(g3.sh, g3.sh, -0.5);
    Q.m_00 = sh12 * sh22;
    Q.m_01 = fma(4.0 * g2.ch * g3.ch, sh12 * g2.sh * g3.sh,
                 2.0 * g1.ch * g1.sh * sh32);
    Q.m_02 = fma(4.0 * g1.ch * g3.ch, g1.sh * g3.sh,
                 -2.0 * g2.ch * sh12 * g2.sh * sh32);
    Q.m_10 = -2.0 * g1.ch * g1.sh * sh22;
    Q.m_11 = fma(-8.0 * g1.ch * g2.ch * g3.ch, g1.sh * g2.sh * g3.sh,
                 sh12 * sh32);
    Q.m_12 = fma(-2.0 * g3.ch, g3.sh,
                 4.0 * g1.sh *
                     fma(g3.ch * g1.sh, g3.sh, g1.ch * g2.ch * g2.sh * sh32));
    Q.m_20 = 2.0 * g2.ch * g2.sh;
    Q.m_21 = -2.0 * g3.ch * sh22 * g3.sh;
    Q.m_22 = sh22 * sh32;
    return SvdQR(Q, R);
}

void main()
{
    SvdMat3 A = SvdMat3(m[0], m[1], m[2], m[3], m[4], m[5], m[6], m[7], m[8]);
    SvdMat3 ata = svd_mat3_mul(svd_mat3_transpose(A), A);
    SvdSym3 sym = SvdSym3(ata.m_00, ata.m_10, ata.m_11, ata.m_20, ata.m_21,
                          ata.m_22);
    SvdMat3 V = svd_mat3_from_quat(svd_jacobi_eigenanalysis(sym));
    SvdMat3 B = svd_mat3_mul(A, V);
    svd_sort_singular_values(B, V);
    SvdQR qr = svd_qr_decomposition(B);
    SvdMat3 U = qr.Q;
    SvdMat3 S = qr.R;
    V = svd_mat3_transpose(V);
    S.m_00 = 1.0;
    S.m_11 = 1.0;
    SvdMat3 r = svd_mat3_mul(U, V);
    S.m_22 = copysignf(1.0, svd_mat3_det(r));
    r = svd_mat3_mul(svd_mat3_mul(U, S), V);
    R[0] = r.m_00;
    R[1] = r.m_01;
    R[2] = r.m_02;
    R[3] = r.m_10;
    R[4] = r.m_11;
    R[5] = r.m_12;
    R[6] = r.m_20;
    R[7] = r.m_21;
    R[8] = r.m_22;
}
