struct VecLJSoft
{
    float x, y, z;
    int lj_type;
    int lj_type_b;
    int mask;
    float charge;
    float charge_ba;
};
layout(set = 0, binding = 0, std430) buffer AtomLocal { int atom_local[]; };
layout(set = 0, binding = 1, std430) buffer LJTypeA { int lj_type_a[]; };
layout(set = 0, binding = 2, std430) buffer LJTypeB { int lj_type_b[]; };
layout(set = 0, binding = 3, std430) buffer Mask { int mask[]; };
layout(set = 0, binding = 4, std430) buffer CrdLocal { VecLJSoft crd_local[]; };
layout(push_constant) uniform Params { int n; } pc;
void main()
{
    int i = int(gl_GlobalInvocationID.x);
    if (i >= pc.n) return;
    int atom_i = atom_local[i];
    crd_local[i].lj_type = lj_type_a[atom_i];
    crd_local[i].lj_type_b = lj_type_b[atom_i];
    crd_local[i].mask = mask[atom_i];
}
