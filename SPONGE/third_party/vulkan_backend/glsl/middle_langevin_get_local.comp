layout(set = 0, binding = 0, std430) buffer AtomLocal { int atom_local[]; };
layout(set = 0, binding = 1, std430) buffer SqrtMass { float d_sqrt_mass[]; };
layout(set = 0, binding = 2, std430) buffer SqrtMassLocal
{
    float d_sqrt_mass_local[];
};
layout(set = 0, binding = 3, std430) buffer MassInv { float d_mass_inverse[]; };
layout(set = 0, binding = 4, std430) buffer MassInvLocal
{
    float d_mass_inverse_local[];
};
layout(push_constant) uniform Params { int local_atom_numbers; } pc;
void main()
{
    int i = int(gl_GlobalInvocationID.x);
    if (i >= pc.local_atom_numbers) return;
    int atom_i = atom_local[i];
    d_sqrt_mass_local[i] = d_sqrt_mass[atom_i];
    d_mass_inverse_local[i] = d_mass_inverse[atom_i];
}
