layout(set = 0, binding = 0, std430) buffer QOut { float q_out[]; };
layout(set = 0, binding = 1, std430) buffer QIn { float q_in[]; };
layout(push_constant) uniform Params
{
    int n;
    float scale;
}
pc;
void main()
{
    int i = int(gl_GlobalInvocationID.x);
    if (i >= pc.n) return;
    q_out[i] = q_in[i] * pc.scale;
}
