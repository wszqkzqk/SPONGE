layout(set = 0, binding = 0, std430) buffer Label { uint label[]; };
layout(set = 0, binding = 1, std430) buffer Frc { Vec3 frc[]; };
layout(set = 0, binding = 2, std430) buffer DdFrc { Vec3 dd_frc[]; };
layout(set = 0, binding = 3, std430) buffer LocalId { int atom_local_id[]; };
layout(push_constant) uniform Params { int atom_numbers; } pc;
uint label_at(int i)
{
    return (label[uint(i) >> 2] >> ((uint(i) & 3u) * 8u)) & 0xFFu;
}
void main()
{
    int i = int(gl_GlobalInvocationID.x);
    if (i >= pc.atom_numbers) return;
    if (label_at(i) == 1u)
    {
        frc[i] = dd_frc[atom_local_id[i]];
    }
    else
    {
        frc[i] = Vec3(0.0, 0.0, 0.0);
    }
}
