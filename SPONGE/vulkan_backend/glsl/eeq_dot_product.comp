layout(set = 0, binding = 0, std430) buffer A { float a[]; };
layout(set = 0, binding = 1, std430) buffer B { float b[]; };
layout(set = 0, binding = 2, std430) buffer Out { floatA out_[]; };
layout(push_constant) uniform Params { int n; } pc;
void main()
{
    int i = int(gl_GlobalInvocationID.x);
    float value = 0.0;
    if (i < pc.n) value = a[i] * b[i];
    float sum = block_sum(value);
    if (gl_LocalInvocationID.x == 0u) afadd(out_[0], sum);
}
