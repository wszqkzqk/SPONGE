struct VecLJ
{
    float x, y, z;
    int lj_type;
    float charge;
};
layout(set = 0, binding = 0, std430) buffer Crd { Vec3 crd[]; };
layout(set = 0, binding = 1, std430) buffer NewCrd { VecLJ new_crd[]; };
layout(set = 0, binding = 2, std430) buffer Charge { float charge[]; };
layout(push_constant) uniform Params { int atom_numbers; } pc;
void main()
{
    int atom_i = int(gl_GlobalInvocationID.x);
    if (atom_i >= pc.atom_numbers) return;
    new_crd[atom_i].x = crd[atom_i].x;
    new_crd[atom_i].y = crd[atom_i].y;
    new_crd[atom_i].z = crd[atom_i].z;
    new_crd[atom_i].charge = charge[atom_i];
}
