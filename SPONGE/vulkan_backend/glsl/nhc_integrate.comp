layout(set = 0, binding = 0, std430) buffer MassInv
{
    float inverse_mass_local[];
};
layout(set = 0, binding = 1, std430) buffer Vel { Vec3 vel[]; };
layout(set = 0, binding = 2, std430) buffer Crd { Vec3 crd[]; };
layout(set = 0, binding = 3, std430) buffer Frc { Vec3 frc[]; };
layout(push_constant) uniform Params
{
    int local_atom_numbers;
    float dt;
    float chain_vel;
    float max_vel;
}
pc;
void main()
{
    int i = int(gl_GlobalInvocationID.x);
    if (i >= pc.local_atom_numbers) return;
    Vec3 temp1 = v3_sub(v3_scale(frc[i], inverse_mass_local[i]),
                        v3_scale(vel[i], pc.chain_vel));
    temp1 = v3_add(vel[i], v3_scale(temp1, pc.dt));
    if (pc.max_vel > 0.0) temp1 = v3_clamp_len(temp1, pc.max_vel);
    vel[i] = temp1;
    crd[i] = v3_add(crd[i], v3_scale(temp1, pc.dt));
}
