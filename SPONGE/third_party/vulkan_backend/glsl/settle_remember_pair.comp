struct ConstrainPair
{
    int atom_i_serial;
    int atom_j_serial;
    float constant_r;
    float constrain_k;
};
layout(set = 0, binding = 0, std430) buffer Pairs { ConstrainPair pairs[]; };
layout(set = 0, binding = 1, std430) buffer Crd { Vec3 crd[]; };
layout(set = 0, binding = 2, std430) buffer LastAB { Vec3 last_pair_AB[]; };
layout(push_constant) uniform Params
{
    int num_task_local;
    Boundary boundary;
}
pc;
void main()
{
    int pair_i = int(gl_GlobalInvocationID.x);
    if (pair_i >= pc.num_task_local) return;
    ConstrainPair pair = pairs[pair_i];
    last_pair_AB[pair_i] = get_displacement(
        crd[pair.atom_j_serial], crd[pair.atom_i_serial], pc.boundary);
}
